			"opacity": 100,
			"angle": 0,
			"x": -53.03540593927562,
			"y": -7.242970784505246,
			"strokeColor": "#c92a2a",
			"backgroundColor": "transparent",
			"width": 388,
			"height": 234,
			"seed": 1752005514,
			"groupIds": [],
			"roundness": null,
			"boundElements": [],
			"updated": 1675185202725,
			"link": null,
			"locked": false,
			"fontSize": 20.06094633264011,
			"fontFamily": 1,
			"text": "Messages Relayed\n\n    Amygdala sends distress signal to \nHypothalamus (in mid-\nbrain) which activates SNS, sending \nsignals to the brain stem to release \nnorepinephrine or noreadrenalin\n(stress hormones) through the brain \nand body.",
			"rawText": "Messages Relayed\n\n    Amygdala sends distress signal to Hypothalamus (in mid-\nbrain) which activates SNS, sending signals to the brain stem to release norepinephrine or noreadrenalin\n(stress hormones) through the brain and body.",
			"baseline": 226,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "yDgbvKpfew2UXQ-4DvV1H",
			"originalText": "Messages Relayed\n\n    Amygdala sends distress signal to Hypothalamus (in mid-\nbrain) which activates SNS, sending signals to the brain stem to release norepinephrine or noreadrenalin\n(stress hormones) through the brain and body."
		},
